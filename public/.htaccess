# E-Okul Disiplin AI Pro v1.1.9 - cPanel / Apache / LiteSpeed ayarları
# Program yalnızca evrakplus.com'a giriş yapmış üyelere açılır (index.php köprüsü).

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # İç dosyalar ve veri klasörü dışarıdan açılamaz
    RewriteRule ^(inc|disiplin_sync_storage)(/|$) - [F,L]
    RewriteRule ^app-shell\.php$ - [F,L]
    # Eski adres (index.html) köprüye yönlenir
    RewriteRule ^index\.html$ index.php [L]
    # Bazı sunucularda Authorization başlığı PHP'ye iletilmez (masaüstü eşitlemesi için)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<Files "app-shell.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

AddType application/manifest+json .webmanifest

# Sayfalar ve service worker her zaman taze yüklensin (anında güncelleme)
<FilesMatch "\.(php|html|webmanifest)$|^sw\.js$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# Derlenmiş dosyalar (adlarında içerik özeti var) uzun süre önbelleklenebilir
<IfModule mod_headers.c>
    <FilesMatch "^index-[A-Za-z0-9_-]{6,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
